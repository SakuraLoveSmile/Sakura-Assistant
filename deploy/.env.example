# 中枢环境样例 —— 复制为 .env 并填值（chmod 600）。真实值绝不提交。
ASSIST_ADMIN_USER=admin
ASSIST_ADMIN_PASSWORD=change-me-32-chars-minimum
ASSIST_BASE_URL=https://hub.example.com
# 中枢镜像版本（docker-compose.yml 引用 ghcr.io/sakuralovesmile/assistant-hub:<该值>）
HUB_VERSION=v1.2.0
# 先发布对应 Agent Release 资产，再部署中枢；此值不带 v，不自动跟随 latest。
ASSIST_AGENT_VERSION=1.2.0
# 安装包缓存不含凭证，可删除后重新下载；默认 512 MiB。
ASSIST_AGENT_CACHE_MAX_BYTES=536870912

# 可选覆盖（默认值即契约值）
# ASSIST_RETENTION_RAW_DAYS=7
# ASSIST_RETENTION_ROLLUP_DAYS=90
# ASSIST_RETENTION_MESSAGES_DAYS=90
